{
  "name": "woosh-browser",
  "version": "1.1.2",
  "description": "Woosh - Your custom browser",
  "main": "main.js",
  "author": "Thomas Fairfield",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.thomas.woosh",
    "productName": "Woosh",
    "directories": { "output": "dist" },
    "files": ["**/*", "!node_modules/.cache", "!dist", "!*.log"],
   "win": { "target": "nsis", "icon": "assets/icon.ico", "publish": null },
"mac": { "target": "dmg", "icon": "assets/icon.icns", "category": "public.app-category.utilities", "publish": null },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Woosh" }
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.0.0"
  }
}
